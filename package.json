{
  "name": "keychron-launcher",
  "productName": "Keychron Launcher",
  "version": "1.0.3",
  "description": "Unofficial native desktop wrapper for the Keychron Launcher web app (launcher.keychron.com), with WebHID support, for Linux, Windows, and macOS",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "author": "Raul Popescu <121046976+RaulKong898@users.noreply.github.com>",
  "repository": "https://github.com/RaulKong898/keychron-launcher-desktop",
  "scripts": {
    "dist:linux": "electron-builder --linux deb rpm pacman --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.keychron.launcher",
    "productName": "Keychron Launcher",
    "asar": true,
    "files": [
      "main.js",
      "package.json",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/icon.icns"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2t64 | libasound2",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0",
        "libnotify4",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Keychron Launcher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keychron Launcher"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
